#!/usr/bin/env bash
#
# Install code-server (VS Code and a terminal in the browser) on the current
# host and run it as a service under a dedicated user, so the workstation can
# be used from any device with only a browser.
#
# Runs on the workstation over SSH. Requires CODE_SERVER_PASSWORD to be set.
# Idempotent: re-running reinstalls nothing but rewrites the config and restarts
# the service with a new password.
#
# The web terminal always runs as the user tog, whichever account ran this
# script. That keeps the web session stable across provisioners, so a local
# shell and a GitHub Actions run both end up with the tog user.

set -o errexit
set -o nounset
set -o pipefail

readonly PASSWORD="${CODE_SERVER_PASSWORD:?CODE_SERVER_PASSWORD is required}"
readonly PORT="8443"
readonly WEB_USER="tog"
readonly CONFIG_DIR="/home/${WEB_USER}/.config/code-server"
readonly CONFIG_FILE="${CONFIG_DIR}/config.yaml"

install_code_server() {
  if command -v code-server >/dev/null 2>&1; then
    return 0
  fi
  if ! command -v curl >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install --yes curl
  fi
  curl -fsSL https://code-server.dev/install.sh | sh
}

ensure_web_user() {
  if ! id "$WEB_USER" >/dev/null 2>&1; then
    sudo useradd --create-home --shell /bin/bash "$WEB_USER"
  fi
  if ! id -nG "$WEB_USER" | tr ' ' '\n' | grep -qx sudo; then
    sudo usermod -aG sudo "$WEB_USER"
  fi
}

write_config() {
  sudo mkdir -p "$CONFIG_DIR"
  cat > /tmp/code-server-config.yaml <<EOF
bind-addr: 0.0.0.0:${PORT}
auth: password
password: ${PASSWORD}
cert: true
disable-telemetry: true
EOF
  sudo install -o "$WEB_USER" -g "$WEB_USER" -m 600 \
    /tmp/code-server-config.yaml "$CONFIG_FILE"
  rm -f /tmp/code-server-config.yaml
}

write_unit() {
  cat > /tmp/code-server.service <<EOF
[Unit]
Description=code-server web terminal
After=network-online.target

[Service]
User=${WEB_USER}
Group=${WEB_USER}
ExecStart=$(command -v code-server) --config ${CONFIG_FILE}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
  sudo install -o root -g root -m 644 \
    /tmp/code-server.service /etc/systemd/system/code-server.service
  rm -f /tmp/code-server.service
}

stop_old_instances() {
  sudo pkill -f 'code-server' >/dev/null 2>&1 || true
  sleep 1
}

start_service() {
  stop_old_instances
  sudo systemctl daemon-reload
  sudo systemctl enable code-server
  sudo systemctl restart code-server
}

wait_until_listening() {
  local attempt=12
  while (( attempt > 0 )); do
    if curl -sk "https://localhost:${PORT}" >/dev/null 2>&1; then
      return 0
    fi
    (( attempt -= 1 ))
    sleep 2
  done
  return 1
}

install_code_server
ensure_web_user
write_config
write_unit
start_service
wait_until_listening || {
  echo "code-server did not come up on port ${PORT}; check: systemctl status code-server" >&2
  exit 1
}
printf 'code-server running on https://localhost:%s as user %s\n' "$PORT" "$WEB_USER"